  },
  {
   "cell_type": "code",
   "execution_count": 101,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Read the mhd file from data\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "import mpl_interactions as pli\n",
    "from gecco import patient_data\n",
    "import gecco as fc\n",
    "import numpy as np\n",
    "from gecco.utils import nrrd_to_mhd, cropping_tool"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## This script generates the rest of the code to run batch GECCO simulations\n",
    "\n",
    "The first few cells are to check the simulation density and phantom are aligned, manually\n",
    "\n",
    "Modify the dictionary so that the last integer specifies the right simulation to load for each of the simulations\n",
    "\n",
    "## Running the GECCO sims\n",
    "\n",
    "The last few cells generate the scripts for running the simulations\n",
    "\n",
    "Best to make a test output directory with only 2 projections\n",
    "\n",
    "From there create the full simulations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 102,
   "metadata": {},
   "outputs": [],
   "source": [
    "nrrd_files = {'0':['/home/berbecolab/2-Datadir/Clinical_data/Pelvis/Pelvis_Female_Patient_1.nrrd',[1,0,2],[313,511,111,367,None,None],2],\n",
    "            '1':['/media/jericho/T7/Clinical_data/Pelvis/Pelvis_Female_Patient_2.nrrd',[1,0,2],[100,400,111,367,None,None],8],\n",
    "            '2':['/home/berbecolab/2-Datadir/Clinical_data/Pelvis/Pelvis_Female_Patient_3.nrrd',[1,0,2],[287,511,2,392,15,78],2],\n",
    "            '3':['/home/berbecolab/2-Datadir/Clinical_data/Pelvis/Pelvis_Prostate_Patient_1.nrrd',[1,0,2],[254,None,None,None,None,None],1],\n",
    "            '4':['/home/berbecolab/2-Datadir/Clinical_data/Pelvis/Pelvis_Prostate_Patient_2.nrrd',[2,1,0],[None,114,None,None,None,None],1],\n",
    "            '5':['/home/berbecolab/2-Datadir/Clinical_data/Pelvis/Pelvis_Prostate_Patient_3.nrrd',[2,1,0],[None,72,None,None,None,None],1],\n",
    "            '6':['/home/berbecolab/2-Datadir/Clinical_data/Pelvis/Pelvis_Prostate_Patient_4.nrrd',[2,1,0],[None,70,None,None,None,None],None],\n",
    "            '7':['/home/berbecolab/2-Datadir/Clinical_data/Pelvis/Pelvis_Prostate_Patient_5.nrrd',[1,0,2],[367,None,None,None,None,None],None]}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 103,
   "metadata": {},
   "outputs": [],
   "source": [
    "file_index = '1'"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load the simulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 104,
   "metadata": {},
   "outputs": [],
   "source": [
    "nrrd_file = nrrd_files[file_index][0]\n",
    "sim_num = nrrd_files[file_index][3]"
   ]
