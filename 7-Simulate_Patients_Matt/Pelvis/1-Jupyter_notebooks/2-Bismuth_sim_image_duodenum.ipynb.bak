   "cell_type": "code",
   "execution_count": 375,
   "metadata": {},
   "outputs": [],
   "source": [
    "phantom.correct_intensity(ml=False,crop=40)\n",
    "# phantom.sim_angles = np.linspace(0,2*np.pi,10)\n",
    "phantom.interpolate_ggems_scatter()\n",
    "phantom.calc_gecco_projections(scat_weight=0.0,noise_weight=1000000) # Creates the gecco projections scatter to primary reduction from asg is 0.48 assumed half is taken by scatter correction\n",
    "# phantom.add_poisson_noise(0.5)\n",
    "phantom.reconstruct_ggems(algo=\"FDK\",filt='ram_lak')"
   ]
