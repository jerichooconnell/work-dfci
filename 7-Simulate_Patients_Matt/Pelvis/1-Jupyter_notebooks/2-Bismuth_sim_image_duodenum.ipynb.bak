   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.ndimage import binary_dilation, binary_fill_holes, gaussian_filter\n",
    "from mpl_toolkits.axes_grid1.inset_locator import zoomed_inset_axes, mark_inset\n",
    "\n",
    "plt.figure(figsize=[10,6])\n",
    "\n",
    "# First subplot\n",
    "plt.subplot(221)\n",
    "plt.imshow(np.rot90(phantom_img_low[31,:,:], 3), cmap='gray', aspect='equal', vmin=np.percentile(phantom_img_low[40], 40), vmax=np.percentile(phantom_img_low[40], 98))\n",
    "plt.title('EKCT low energy')\n",
    "# plt.axis('off')\n",
    "\n",
    "# Create a mask where the phantom.phantom equals 10 or 11 in slice 40\n",
    "mask = (phantom.phantom[31] == 23) | (phantom.phantom[31] == 24)\n",
    "\n",
    "# Binary expand the mask\n",
    "mask = binary_dilation(mask)\n",
    "mask = binary_fill_holes(mask)\n",
    "\n",
    "\n",
    "mask_2 = np.rot90(mask, 3)\n",
    "\n",
    "\n",
    "# Turn the zero entries in the mask to NaN\n",
    "mask = mask.astype(float)\n",
    "mask[mask == 0] = np.nan\n",
    "\n",
    "# plt.imshow(np.rot90(mask, 3), cmap='flag', alpha=0.5)\n",
    "\n",
    "# Zoom inset\n",
    "axins1 = zoomed_inset_axes(plt.gca(), 1.5, loc='upper right')\n",
    "axins1.imshow(np.rot90(phantom_img_low[31,:,:], 3), cmap='gray', aspect='equal', vmin=np.percentile(phantom_img_low[40], 40), vmax=np.percentile(phantom_img_low[40], 98))\n",
    "axins1.imshow(np.rot90(mask, 3), cmap='flag', alpha=0.5)\n",
    "\n",
    "# make a bounding box around the mask\n",
    "\n",
    "\n",
    "x1, x2, y1, y2 = 240,  290, 150, 100  # Specify the zoom area\n",
    "axins1.set_xlim(x1, x2)\n",
    "axins1.set_ylim(y1, y2)\n",
    "# axins1.axis('off')\n",
    "axins1.yaxis.get_major_locator().set_params(nbins=7)\n",
    "axins1.xaxis.get_major_locator().set_params(nbins=7)\n",
    "axins1.tick_params(labelleft=False, labelbottom=False)\n",
    "# mark_inset(plt.gca(), axins1, loc1=1.5, loc2=4, fc=\"none\", ec=\"0.5\")\n",
    "\n",
    "# Second subplot\n",
    "plt.subplot(222)\n",
    "plt.imshow(np.rot90(phantom_img_high[31,:,:], 3), cmap='gray', aspect='equal', vmin=np.percentile(phantom_img_high[40], 40), vmax=np.percentile(phantom_img_high[40], 98))\n",
    "plt.title('EKCT bismuth')\n",
    "plt.axis('off')\n",
    "\n",
    "img_low = gaussian_filter(phantom_img_low[31,:,:], sigma=2)\n",
    "img_high = gaussian_filter(phantom_img_high[31,:,:], sigma=2)\n",
    "img_sub = (img_low - img_high) / img_low\n",
    "img_sub[phantom.density[31] < 0.5] = np.NaN\n",
    "plt.imshow(np.rot90(img_sub, 3), cmap='turbo_r', aspect='equal', vmin=np.nanpercentile(img_sub, 0.5), vmax=np.nanpercentile(img_sub, 70), alpha=0.9)\n",
    "\n",
    "# Third subplot\n",
    "plt.subplot(223)\n",
    "plt.imshow(np.rot90(phantom_img_low2[31,:,:], 3), cmap='gray', aspect='equal', vmin=np.percentile(phantom_img_low2[40], 40), vmax=np.percentile(phantom_img_low[40], 98))\n",
    "plt.title('Conventional low energy')\n",
    "# plt.axis('off')\n",
    "\n",
    "# Create a mask where the phantom.phantom equals 10 or 11 in slice 40\n",
    "mask2 = (phantom.phantom[31] == 23) | (phantom.phantom[31] == 24)\n",
    "\n",
    "# Binary expand the mask\n",
    "mask2 = binary_dilation(mask2)\n",
    "mask2 = binary_fill_holes(mask2)\n",
    "\n",
    "# Turn the zero entries in the mask to NaN\n",
    "mask2 = mask2.astype(float)\n",
    "mask2[mask2 == 0] = np.nan\n",
    "\n",
    "plt.imshow(np.rot90(mask2, 3), cmap='flag', alpha=0.5)\n",
    "\n",
    "# Zoom inset\n",
    "axins2 = zoomed_inset_axes(plt.gca(), 1.5, loc='upper right')\n",
    "axins2.imshow(np.rot90(phantom_img_low2[31,:,:], 3), cmap='gray', aspect='equal', vmin=np.percentile(phantom_img_low2[40], 40), vmax=np.percentile(phantom_img_low[40], 98))\n",
    "axins2.imshow(np.rot90(mask2, 3), cmap='flag', alpha=0.5)\n",
    "axins2.set_xlim(x1, x2)\n",
    "axins2.set_ylim(y1, y2)\n",
    "# axins2.axis('off')\n",
    "# mark_inset(plt.gca(), axins1.5, loc1=1.5, loc2=4, fc=\"none\", ec=\"0.5\")\n",
    "\n",
    "# Fourth subplot\n",
    "plt.subplot(224)\n",
    "plt.imshow(np.rot90(phantom_img_high2[31,:,:], 3), cmap='gray', aspect='equal', vmin=np.percentile(phantom_img_high2[40], 0.5), vmax=np.percentile(phantom_img_high[40], 98))\n",
    "plt.title('Conventional bismuth')\n",
    "plt.axis('off')\n",
    "\n",
    "# Gaussian filter the images\n",
    "img_low2 = gaussian_filter(phantom_img_low2[31,:,:], sigma=1.5)\n",
    "img_high2 = gaussian_filter(phantom_img_high2[31,:,:], sigma=1.5)\n",
    "img_sub2 = (img_low2 - img_high2) / img_low2\n",
    "img_sub2[phantom.density[31] < 0.5] = np.NaN\n",
    "\n",
    "plt.imshow(np.rot90(img_sub2, 3), cmap='turbo_r', aspect='equal', vmin=np.nanpercentile(img_sub2, 0.5), vmax=np.nanpercentile(img_sub2, 98), alpha=0.9)\n",
    "\n",
    "# plt.tight_layout()\n",
    "# plt.show()"
   ]
  },
